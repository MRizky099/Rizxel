+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum GripSide {
+    /// A vertical grip on the left edge, for wide, short groups such as a toolbar.
+    Left,
+    /// A horizontal grip on the top edge, for narrow, tall groups such as a tool rail.
+    Top,
+}
