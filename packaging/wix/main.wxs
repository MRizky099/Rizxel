<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rizxel MSI (WiX Toolset 5). Per-user: installs to %LocalAppData%\Programs\Rizxel
  without admin rights and registers .rzxl under HKCU\Software\Classes; uninstall
  removes both. Built by .github/workflows/release.yml:

    wix build packaging/wix/main.wxs -ext WixToolset.UI.wixext
      -d Version=0.9.0 -d Stage=<staged files> -d Assets=assets -o Rizxel.msi

  <Stage> holds rizxel.exe, LICENSE, License.rtf, THIRD_PARTY_LICENSES.html,
  README.md and craft-ui\{LICENSE-MIT,LICENSE-APACHE,NOTICE}.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Rizxel"
           Manufacturer="Muhammad Rizky Abdillah (MRizky099)"
           Version="$(var.Version)"
           UpgradeCode="0c25dde2-e90e-4a7e-aa66-1451af800f05"
           Scope="perUser"
           Language="1033">
    <SummaryInformation Description="Rizxel voxel editor" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Rizxel is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="RizxelIcon" SourceFile="$(var.Assets)\Rizxel_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="RizxelIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MRizky099/Rizxel" />
    <Property Id="ARPHELPLINK" Value="https://github.com/MRizky099/Rizxel/issues" />

    <!-- The GPL is shown for information; it needs no acceptance to run Rizxel. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Stage)\License.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Rizxel">
          <Directory Id="CraftUiDir" Name="craft-ui" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Per-user components need an HKCU key path (ICE38). -->
    <Component Id="AppFiles" Directory="INSTALLFOLDER" Guid="6a3c1f0e-3a55-4d0c-9a8e-6b1f0c7e2d11">
      <RegistryValue Root="HKCU" Key="Software\Rizxel" Name="InstallDir" Type="string"
                     Value="[INSTALLFOLDER]" KeyPath="yes" />
      <File Id="RizxelExe" Source="$(var.Stage)\rizxel.exe" KeyPath="no" />
      <File Id="License" Source="$(var.Stage)\LICENSE" KeyPath="no" />
      <File Id="ThirdParty" Source="$(var.Stage)\THIRD_PARTY_LICENSES.html" KeyPath="no" />
      <File Id="Readme" Source="$(var.Stage)\README.md" KeyPath="no" />
      <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
    </Component>

    <Component Id="CraftUiNotices" Directory="CraftUiDir" Guid="9d2e4b7a-1c3f-4e5d-8a6b-2f7c9e0d1a22">
      <RegistryValue Root="HKCU" Key="Software\Rizxel" Name="CraftUiNotices" Type="integer"
                     Value="1" KeyPath="yes" />
      <File Id="CraftMit" Source="$(var.Stage)\craft-ui\LICENSE-MIT" KeyPath="no" />
      <File Id="CraftApache" Source="$(var.Stage)\craft-ui\LICENSE-APACHE" KeyPath="no" />
      <File Id="CraftNotice" Source="$(var.Stage)\craft-ui\NOTICE" KeyPath="no" />
      <RemoveFolder Id="RemoveCraftUiDir" On="uninstall" />
    </Component>

    <Component Id="StartMenu" Directory="ProgramMenuFolder" Guid="3b8f2c1d-5e6a-4f7b-9c0d-4e1a2b3c5d33">
      <Shortcut Id="RizxelShortcut" Name="Rizxel" Description="Voxel art editor"
                Target="[INSTALLFOLDER]rizxel.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Rizxel" Name="StartMenu" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>

    <!--
      .rzxl file association (same values as Settings > Associate in portable
      builds, rizxel-ui/src/file_assoc.rs). The document icon is the exe's icon
      resource 2. .vox and .gox only get an Open with entry.
    -->
    <Component Id="FileAssociation" Directory="INSTALLFOLDER" Guid="7e4d3c2b-9a8f-4b6e-8d1c-5f2a3b4c6e44">
      <RegistryValue Root="HKCU" Key="Software\Classes\.rzxl" Type="string" Value="Rizxel.Project" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\.rzxl" Name="Content Type" Type="string" Value="application/x-rizxel" />
      <RegistryValue Root="HKCU" Key="Software\Classes\.rzxl\OpenWithProgids" Name="Rizxel.Project" Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Rizxel.Project" Type="string" Value="Rizxel Project" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Rizxel.Project\DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]rizxel.exe&quot;,-2" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Rizxel.Project\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]rizxel.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Rizxel.Model" Type="string" Value="Voxel Model" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Rizxel.Model\DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]rizxel.exe&quot;,0" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Rizxel.Model\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]rizxel.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Applications\rizxel.exe" Name="FriendlyAppName" Type="string" Value="Rizxel" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Applications\rizxel.exe\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]rizxel.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Applications\rizxel.exe\SupportedTypes" Name=".rzxl" Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Applications\rizxel.exe\SupportedTypes" Name=".vox" Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Applications\rizxel.exe\SupportedTypes" Name=".gox" Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Classes\.vox\OpenWithProgids" Name="Rizxel.Model" Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Classes\.gox\OpenWithProgids" Name="Rizxel.Model" Type="string" Value="" />
    </Component>

    <Feature Id="Main" Title="Rizxel">
      <ComponentRef Id="AppFiles" />
      <ComponentRef Id="CraftUiNotices" />
      <ComponentRef Id="StartMenu" />
      <ComponentRef Id="FileAssociation" />
    </Feature>
  </Package>
</Wix>
